{
	"compilerOptions": {
		"paths": {
			"@hadyancode/agents": ["../sdk/packages/agents/src/index.ts"],
			"@hadyancode/agents/*": [
				"../sdk/packages/agents/src/*",
				"../sdk/packages/agents/src/*/index.ts"
			],
			"@hadyancode/hadyancode-hub": ["./hadyancode-hub/src/server.ts"],
			"@hadyancode/core": ["../sdk/packages/core/src/index.ts"],
			"@hadyancode/core/hub/daemon-entry": [
				"../sdk/packages/core/src/hub/daemon/entry.ts"
			],
			"@hadyancode/core/*": [
				"../sdk/packages/core/src/*",
				"../sdk/packages/core/src/*/index.ts"
			],
			"@hadyancode/core/telemetry": [
				"../sdk/packages/core/src/services/telemetry/index.ts"
			],
			"@hadyancode/llms": ["../sdk/packages/llms/src/index.ts"],
			"@hadyancode/shared": ["../sdk/packages/shared/src/index.ts"],
			"@hadyancode/shared/storage": ["../sdk/packages/shared/src/storage/index.ts"],
			"@hadyancode/shared/db": ["../sdk/packages/shared/src/db/index.ts"],
			"@hadyancode/shared/*": [
				"../sdk/packages/shared/src/*",
				"../sdk/packages/shared/src/*/index.ts"
			]
		}
	}
}
